# Patterns without **/ only match at the root of the build context.

# Build outputs and dependencies (rebuilt inside the image)
**/bin/
**/obj/
**/node_modules/
**/dist/

# Local tooling and git
.git/
**/.vs/
**/.vscode/
**/.idea/
**/*.user
**/*.suo

# Local planning and secrets
work/
**/.env
**/.env.*
!.env.example
**/*.local
**/appsettings.*.local.json

# Docker, CI and hosting files (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore
.github/
render.yaml
