# Copy this file to .env and adjust. The .env file is read by docker compose and must never be committed.

# Port on your machine where the app is published (http://localhost:8080).
API_PORT=8080

# Password of the local PostgreSQL (required). Pick any value; it only exists on your machine.
POSTGRES_PASSWORD=change-me

# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey) to show the logged-in user's
# Steam name and avatar. Leave empty to run without them.
STEAM_API_KEY=

# Token between the API and the replay parser (Go service). Required, and a SECRET: never commit it or paste it
# anywhere public. Generate a random one in PowerShell and paste it here (the same value goes to Render later):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') }) | Set-Clipboard
REPLAY_PARSER_API_KEY=

# Optional: ngrok tunnel so the API on Render can use the replay parser on this machine (docker-compose.yml,
# service "tunnel"). From https://dashboard.ngrok.com: the authtoken (a SECRET) and your free static domain,
# as a full URL (e.g. https://something.ngrok-free.app). Render then gets ReplayParser__BaseUrl = that URL
# followed by "/" and ReplayParser__ApiKey = REPLAY_PARSER_API_KEY above.
NGROK_AUTHTOKEN=
NGROK_URL=
# Uncomment so a plain "docker compose up" also starts the tunnel on this machine.
# COMPOSE_PROFILES=tunnel

# Port of the local PostgreSQL on your machine (127.0.0.1 only), for F5 and pgAdmin.
POSTGRES_PORT=5432

# Optional: collector of the comparison base (docker-compose.yml, service "collector", profile "collector"). All the
# heavy work stays on this machine (raw base in the local database); every hour only the finished base is published to
# the local site and, when MIRROR_DATABASE is set, to production (Neon) — a few MB however big the base gets.
# MIRROR_DATABASE: Neon's connection string in .NET format (a SECRET): Host=...;Database=...;Username=...;
# Password=...;SSL Mode=Require. COLLECTOR_FOCUS_ACCOUNT_ID: whose heroes the high-rank matches must have.
# To start it with "docker compose up": COMPOSE_PROFILES=tunnel,collector.
MIRROR_DATABASE=
COLLECTOR_FOCUS_ACCOUNT_ID=
COLLECTOR_DAILY_LIMIT=300