# Copy this file to .env and adjust. The .env file is read by docker compose and must never be committed.

# Port on your machine where the app is published (http://localhost:8080).
API_PORT=8080

# Password of the local PostgreSQL (required). Pick any value; it only exists on your machine.
POSTGRES_PASSWORD=change-me

# Port of the local PostgreSQL on your machine (127.0.0.1 only), for F5 and pgAdmin.
POSTGRES_PORT=5432
