<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DotaAnalyst.Application\DotaAnalyst.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The map of each patch (tools/MapExtractor), read by GameMapCatalog. -->
    <EmbeddedResource Include="GameData\Maps\*.map.json.gz" LogicalName="DotaAnalyst.Maps.%(Filename)%(Extension)" />
    <!-- Valve's patch list as of the last save, used when Valve is not asked or does not answer (GamePatchCatalog). -->
    <EmbeddedResource Include="GameData\Patches\patchnoteslist.json" LogicalName="DotaAnalyst.Patches.patchnoteslist.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests use OpenDotaClient.JsonOptions to read JSON fixtures exactly like the client. -->
    <InternalsVisibleTo Include="DotaAnalyst.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
