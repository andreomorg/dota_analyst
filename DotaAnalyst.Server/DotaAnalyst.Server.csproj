<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\dotaanalyst.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:59438</SpaProxyServerUrl>
    <UserSecretsId>3da24362-d452-4e0f-b16f-604688c26d4a</UserSecretsId>
    <!-- The /// comments of the controllers become the endpoint descriptions in the OpenAPI document.
         CS1591 ("missing XML comment") is off: only what the API exposes is documented. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotaAnalyst.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not used directly: AspNet.Security.OpenId depends on AngleSharp 1.3.0, which has a known
         vulnerability (GHSA-pgww-w46g-26qg, fixed in 1.5.0). This direct reference raises it to a fixed
         version. Remove it once AspNet.Security.OpenId depends on 1.5.0 or later. -->
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="AspNet.Security.OpenId.Steam" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Docker build passes -p:ExcludeSpaClient=true: React is built in its own Node stage,
         and the .NET SDK stage has neither Node/npm nor the client folder. -->
    <ProjectReference Include="..\dotaanalyst.client\dotaanalyst.client.esproj" Condition="'$(ExcludeSpaClient)' != 'true'">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\DotaAnalyst.Application\DotaAnalyst.Application.csproj" />
    <ProjectReference Include="..\DotaAnalyst.Infrastructure\DotaAnalyst.Infrastructure.csproj" />
  </ItemGroup>

</Project>
