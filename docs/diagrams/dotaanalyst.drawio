                        <mxPoint x="560" y="300" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t6" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;endSize=6;" value="cookie de sessão (30 dias)&lt;br&gt;volta à página de origem">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="325" y="360" as="sourcePoint"/>
                        <mxPoint x="95" y="360" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t7" edge="1" parent="1" style="html=1;endArrow=block;endSize=6;" value="GET /api/v1/me">
