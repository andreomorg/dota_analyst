<mxCell id="c2" value="métricas dos 10 heróis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="c3" value="grava · conta partidas por herói" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;labelBackgroundColor=#ffffff;startArrow=classic;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b2" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
