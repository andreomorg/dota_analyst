<mxCell id="legend-base" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;Para comparar você com outros jogadores do mesmo herói e posição. Caixas &lt;b&gt;verdes&lt;/b&gt;: etapas que rodam na máquina do dono do projeto. Cilindros &lt;b&gt;amarelos&lt;/b&gt;: banco local; &lt;b&gt;azuis&lt;/b&gt;: produção (Neon).&lt;br&gt;A base &lt;b&gt;bruta&lt;/b&gt; (métricas de cada herói de cada partida) nunca sai da máquina local; de hora em hora só os &lt;b&gt;percentis&lt;/b&gt; prontos vão para o Neon (linha laranja), alguns KB.&lt;br&gt;O site local e a produção leem a mesma tabela pronta: o que aparece em localhost é o que vai ao ar." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="920" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram>
    <diagram id="login" name="5. Login Steam">
        <mxGraphModel dx="874" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="s1" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=40;html=1;" value="Navegador" vertex="1">
                    <mxGeometry height="460" width="110" x="40" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=40;html=1;" value="API (AuthController)" vertex="1">
                    <mxGeometry height="460" width="130" x="260" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=40;html=1;" value="Steam OpenID" vertex="1">
                    <mxGeometry height="460" width="120" x="500" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="t1" edge="1" parent="1" style="html=1;endArrow=block;endSize=6;" value="GET /api/v1/auth/login?returnUrl=">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="95" y="110" as="sourcePoint"/>
                        <mxPoint x="325" y="110" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t2" edge="1" parent="1" style="html=1;endArrow=open;dashed=1;endSize=6;" value="redireciona para a Steam">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="325" y="150" as="sourcePoint"/>
                        <mxPoint x="95" y="150" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t3" edge="1" parent="1" style="html=1;endArrow=block;endSize=6;" value="senha ou QR code (app Steam)">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="95" y="200" as="sourcePoint"/>
                        <mxPoint x="560" y="200" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t4" edge="1" parent="1" style="html=1;endArrow=block;endSize=6;" value="volta para /api/auth/steam/callback">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="560" y="250" as="sourcePoint"/>
                        <mxPoint x="325" y="250" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t5" edge="1" parent="1" style="html=1;endArrow=block;endSize=6;" value="check_authentication (confirma)">
                    <mxGeometry relative="1" as="geometry">
