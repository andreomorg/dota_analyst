<mxCell id="b4" value="baseline_matches&lt;br&gt;baseline_metrics&lt;br&gt;(bruto · local)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="150" height="100" as="geometry"/></mxCell>
