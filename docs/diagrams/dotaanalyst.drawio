<mxCell id="local" value="Somente no banco local · bruto / pesado" style="swimlane;startSize=34;rounded=1;fillColor=#f3faf4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="300" height="380" as="geometry"/></mxCell>
