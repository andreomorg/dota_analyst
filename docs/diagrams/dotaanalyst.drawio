<mxCell id="r1" value="1 partida → 10 heróis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#526579;strokeWidth=2;html=1;endArrow=classic;labelBackgroundColor=#ffffff;" edge="1" parent="local" source="d8" target="d9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="publish-note" value="Publicação do resumo: baseline_metrics → baseline_distributions (local + Neon)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="430" width="700" height="60" as="geometry"/></mxCell>
<mxCell id="legend-banco" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;Área &lt;b&gt;azul&lt;/b&gt;: tabelas que existem nos dois bancos (o local e o Neon, em produção), com dados já refinados. Área &lt;b&gt;verde&lt;/b&gt;: tabelas só do banco local, com dados brutos e pesados (o replay inteiro, a base de comparação bruta).&lt;br&gt;Em produção o Neon recebe só o que é mostrado na tela." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="900" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="coach" name="7. Coach experimental"><mxGraphModel grid="1" page="1" pageWidth="1260" pageHeight="680" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Coach experimental · dados, reflexão e avaliação&lt;/b&gt;&lt;br&gt;Execução local; fluxo separado do produto em produção" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#f8f9fb;strokeColor=#9aa7b5;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="75" as="geometry"/></mxCell>
<mxCell id="replay" value="&lt;b&gt;Replay arquivado&lt;/b&gt;&lt;br&gt;Mesmo adapter do parser&lt;br&gt;Posições transitórias" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="episodes" value="&lt;b&gt;Domain · episódios&lt;/b&gt;&lt;br&gt;Mortes / lutas e cobertura&lt;br&gt;Confirmado ≠ desconhecido" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="345" y="145" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="facts" value="&lt;b&gt;Domain · fatos canônicos&lt;/b&gt;&lt;br&gt;Distância e disponibilidade na âncora&lt;br&gt;Separação temporal do mesmo aliado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="660" y="145" width="255" height="115" as="geometry"/></mxCell>
<mxCell id="observation" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;Observação v2 preservada&lt;br&gt;Qualitativo v3 / temporal v4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="990" y="145" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="model" value="&lt;b&gt;Modelo local&lt;/b&gt;&lt;br&gt;Hipótese / alternativa / exercício&lt;br&gt;Sem recalcular fatos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="990" y="345" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="validate" value="&lt;b&gt;Validação estrutural&lt;/b&gt;&lt;br&gt;Versão, cena, campos e aliases&lt;br&gt;Restaura IDs somente no backend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="660" y="345" width="255" height="115" as="geometry"/></mxCell>
<mxCell id="review" value="&lt;b&gt;Avaliação de conteúdo&lt;/b&gt;&lt;br&gt;Contradições, utilidade e limites&lt;br&gt;Revisão humana posterior" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="345" y="345" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="decision" value="&lt;b&gt;Decisão atual&lt;/b&gt;&lt;br&gt;Sem promoção ao produto&lt;br&gt;Teste reservado fechado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="restricted" value="&lt;b&gt;Caminho restrito preservado&lt;/b&gt;&lt;br&gt;Contexto v4 → achados elegíveis → modelo seleciona IDs → Application renderiza texto factual. Não é treinamento." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="585" height="105" as="geometry"/></mxCell>
<mxCell id="training" value="&lt;b&gt;Experimentos de aprendizado separados&lt;/b&gt;&lt;br&gt;v3/v4: aliases no modelo; valores e tempos no backend. Cobertura intermediária não reconstrói trajeto, visão ou causa. Formato válido não aprova conteúdo. Treinos separados, sem candidato aprovado." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fillColor=#f8f9fb;strokeColor=#9aa7b5;align=left;" vertex="1" parent="1"><mxGeometry x="660" y="530" width="570" height="105" as="geometry"/></mxCell>
