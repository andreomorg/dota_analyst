<mxCell id="r1" value="1 partida → 10 heróis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#526579;strokeWidth=2;html=1;endArrow=classic;labelBackgroundColor=#ffffff;" edge="1" parent="local" source="d8" target="d9"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="publish-note" value="Publicação do resumo: baseline_metrics → baseline_distributions (local + Neon)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="430" width="700" height="60" as="geometry" /></mxCell>
<mxCell id="legend-banco" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;Área &lt;b&gt;azul&lt;/b&gt;: tabelas que existem nos dois bancos (o local e o Neon, em produção), com dados já refinados. Área &lt;b&gt;verde&lt;/b&gt;: tabelas só do banco local, com dados brutos e pesados (o replay inteiro, a base de comparação bruta).&lt;br&gt;Em produção o Neon recebe só o que é mostrado na tela." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="900" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="coach" name="7. Coach experimental"><mxGraphModel grid="1" page="1" pageWidth="1320" pageHeight="760" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;7. Coach experimental&lt;/b&gt;&lt;br&gt;Evidências no C# · revisão interna no Python · produto público preservado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;spacing=14;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;"><mxGeometry x="30" y="20" width="1260" height="80" as="geometry" /></mxCell><mxCell id="archive" value="&lt;b&gt;Replay arquivado&lt;/b&gt;&lt;br&gt;Parser Go / armazenamento local&lt;br&gt;Sem novo parse nesta revisão" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;"><mxGeometry x="30" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="facts" value="&lt;b&gt;Domain / Application · C#&lt;/b&gt;&lt;br&gt;Episódios, fatos e contexto&lt;br&gt;Âncora separada do resultado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;"><mxGeometry x="360" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="client" value="&lt;b&gt;Infrastructure · C#&lt;/b&gt;&lt;br&gt;CoachMlClient / chave de máquina&lt;br&gt;Payload e resposta limitados" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;"><mxGeometry x="690" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="service" value="&lt;b&gt;Serviço Python / Docker&lt;/b&gt;&lt;br&gt;Prévia CPU por política&lt;br&gt;Ollama opcional, sem treino aqui" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;"><mxGeometry x="1020" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="return" value="&lt;b&gt;Revisão provisória&lt;/b&gt;&lt;br&gt;Engine, cenas e referências&lt;br&gt;Sem recalcular fatos do C#" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;"><mxGeometry x="1020" y="370" width="260" height="120" as="geometry" /></mxCell><mxCell id="validate" value="&lt;b&gt;Validação no C#&lt;/b&gt;&lt;br&gt;Contrato, identidade e evidências&lt;br&gt;Recusa resposta incompatível" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;"><mxGeometry x="690" y="370" width="260" height="120" as="geometry" /></mxCell><mxCell id="review" value="&lt;b&gt;Review de conteúdo&lt;/b&gt;&lt;br&gt;Fidelidade, utilidade e limites&lt;br&gt;Formato não aprova tática" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;"><mxGeometry x="360" y="370" width="260" height="120" as="geometry" /></mxCell><mxCell id="product" value="&lt;b&gt;Estado do produto&lt;/b&gt;&lt;br&gt;Dicas públicas seguem as regras&lt;br&gt;Sem adaptador promovido" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;"><mxGeometry x="30" y="370" width="260" height="120" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="archive" target="facts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="facts" target="client" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="client" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="service" target="return" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" edge="1" parent="1" source="return" target="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" edge="1" parent="1" source="validate" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" edge="1" parent="1" source="review" target="product" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Limites do fluxo&lt;/b&gt;&lt;br&gt;Posições são oniscientes; compras não comprovam entrega; upgrades não comprovam cooldown. A validação estrutural não demonstra causalidade ou qualidade tática. Treino e promoção são decisões separadas: veja a página 8; as chamadas HTTP estão na página 9." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;"><mxGeometry x="30" y="590" width="1260" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="coach-training" name="8. Curadoria, treino e avaliação"><mxGraphModel grid="1" page="1" pageWidth="1320" pageHeight="760" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;8. Curadoria, treino e avaliação&lt;/b&gt;&lt;br&gt;Pipeline local e offline · serviço HTTP não inicia treino nem promove adaptadores" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;spacing=14;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;"><mxGeometry x="30" y="20" width="1260" height="80" as="geometry" /></mxCell><mxCell id="corpus" value="&lt;b&gt;Corpus / manifest&lt;/b&gt;&lt;br&gt;Divisão por partida&lt;br&gt;Treino, validação e test reservado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;"><mxGeometry x="30" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="curation" value="&lt;b&gt;Curadoria Python&lt;/b&gt;&lt;br&gt;Seis competências / política v2&lt;br&gt;Alvos provisórios com origem" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;"><mxGeometry x="360" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="audit" value="&lt;b&gt;Auditoria CPU&lt;/b&gt;&lt;br&gt;Hashes, duplicatas e cobertura&lt;br&gt;Tokenizer local / sem truncar" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;"><mxGeometry x="690" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="prepare" value="&lt;b&gt;Prepare / GPU&lt;/b&gt;&lt;br&gt;Pior microbatch e gradientes&lt;br&gt;Congela dados, código e ambiente" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;"><mxGeometry x="1020" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="train" value="&lt;b&gt;Run / GPU · uma época&lt;/b&gt;&lt;br&gt;Base intacta / LoRA separado&lt;br&gt;Orçamento e imagem fixados" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;"><mxGeometry x="1020" y="370" width="260" height="120" as="geometry" /></mxCell><mxCell id="checkpoint" value="&lt;b&gt;Checkpoint selado&lt;/b&gt;&lt;br&gt;Adaptador, otimizador e RNG&lt;br&gt;SHA-256 antes da retomada" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;"><mxGeometry x="690" y="370" width="260" height="120" as="geometry" /></mxCell><mxCell id="evaluate" value="&lt;b&gt;Inferência e avaliação&lt;/b&gt;&lt;br&gt;Mesmos casos: base × adaptado&lt;br&gt;Fatos, foco, ganhos e regressões" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;"><mxGeometry x="360" y="370" width="260" height="120" as="geometry" /></mxCell><mxCell id="decision" value="&lt;b&gt;Review / decisão explícita&lt;/b&gt;&lt;br&gt;Conteúdo e limitações&lt;br&gt;Sem promoção automática" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;"><mxGeometry x="30" y="370" width="260" height="120" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="corpus" target="curation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="curation" target="audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="audit" target="prepare" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="prepare" target="train" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" edge="1" parent="1" source="train" target="checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" edge="1" parent="1" source="checkpoint" target="evaluate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" edge="1" parent="1" source="evaluate" target="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Separações obrigatórias&lt;/b&gt;&lt;br&gt;Mesmo exemplo em tarefas diferentes não vira nova partida. Test reservado permanece fechado nesta preparação. Checkpoints são intermediários; a comparação usa o adaptador final. Snapshot copia previsões para avaliação CPU isolada, preservando a origem. Loss baixa e reprodução de templates não comprovam domínio tático." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;"><mxGeometry x="30" y="590" width="1260" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="coach-http" name="9. Integração interna C# ↔ Python"><mxGraphModel grid="1" page="1" pageWidth="1320" pageHeight="760" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;9. Integração interna C# ↔ Python&lt;/b&gt;&lt;br&gt;Chave de máquina / Bearer · callbacks fixos · separado da autenticação Steam" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;spacing=14;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;"><mxGeometry x="30" y="20" width="1260" height="80" as="geometry" /></mxCell><mxCell id="request" value="&lt;b&gt;API C# · requisição interna&lt;/b&gt;&lt;br&gt;POST /api/internal/coach/&lt;br&gt;reviews/{matchId}/{heroId}" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;"><mxGeometry x="30" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="context" value="&lt;b&gt;C# prepara o contexto&lt;/b&gt;&lt;br&gt;Replay já arquivado&lt;br&gt;No máximo três cenas" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;"><mxGeometry x="360" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="python" value="&lt;b&gt;Python recebe evidências&lt;/b&gt;&lt;br&gt;POST /v1/reviews&lt;br&gt;Prévia CPU / Ollama opcional" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;"><mxGeometry x="690" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="result" value="&lt;b&gt;C# valida a resposta&lt;/b&gt;&lt;br&gt;Engine, IDs e referências&lt;br&gt;Retorna revisão provisória" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;"><mxGeometry x="1020" y="150" width="260" height="120" as="geometry" /></mxCell><mxCell id="request-e0" edge="1" parent="1" source="request" target="context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="request-e1" edge="1" parent="1" source="context" target="python" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="request-e2" edge="1" parent="1" source="python" target="result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="by-match" value="&lt;b&gt;Alternativa · entrada Python&lt;/b&gt;&lt;br&gt;POST /v1/reviews/by-match&lt;br&gt;Recebe matchId e heroId" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;"><mxGeometry x="30" y="390" width="260" height="120" as="geometry" /></mxCell><mxCell id="callback" value="&lt;b&gt;Python consulta C#&lt;/b&gt;&lt;br&gt;GET /api/internal/coach/&lt;br&gt;contexts/{matchId}/{heroId}" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;"><mxGeometry x="360" y="390" width="260" height="120" as="geometry" /></mxCell><mxCell id="bounded" value="&lt;b&gt;C# devolve evidências&lt;/b&gt;&lt;br&gt;Contexto limitado / já arquivado&lt;br&gt;Sem acesso Python ao banco" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;"><mxGeometry x="690" y="390" width="260" height="120" as="geometry" /></mxCell><mxCell id="respond" value="&lt;b&gt;Python revisa e responde&lt;/b&gt;&lt;br&gt;Engine explícita e referências&lt;br&gt;Sem aprovação humana implícita" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;"><mxGeometry x="1020" y="390" width="260" height="120" as="geometry" /></mxCell><mxCell id="by-match-e0" edge="1" parent="1" source="by-match" target="callback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="by-match-e1" edge="1" parent="1" source="callback" target="bounded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="by-match-e2" edge="1" parent="1" source="bounded" target="respond" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Rotas protegidas; sem novo destino público no React&lt;/b&gt;&lt;br&gt;O serviço Python é opcional e interno. Nenhuma rota acima publica ou treina adaptador. Contexto ausente e falhas de contrato/upstream têm respostas próprias; a API pública, Steam e as dicas por regras mantêm seus contratos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=14;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;"><mxGeometry x="30" y="610" width="1260" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>