<mxCell id="note" value="Dependências apontam para dentro&lt;br&gt;Server → Application → Domain&lt;br&gt;Infrastructure → Application" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="750" y="450" width="250" height="90" as="geometry" /></mxCell>
<mxCell id="a5" value="HTTP · /api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="react" target="server"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a1" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="server" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a4" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="app" target="domain"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a2" value="registra no DI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeWidth=2;html=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.3;" edge="1" parent="1" source="server" target="infra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="102" /><mxPoint x="700" y="287" /></Array></mxGeometry></mxCell>
<mxCell id="a3" value="implementa interfaces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeWidth=2;endArrow=block;endFill=0;html=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="infra" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="legend-camadas" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;Cada caixa é um projeto .NET. Seta &lt;b&gt;contínua &quot;usa&quot;&lt;/b&gt;: o projeto de cima depende do de baixo. Seta &lt;b&gt;tracejada &quot;registra no DI&quot;&lt;/b&gt;: na subida, o Server liga as implementações da Infrastructure. Seta &lt;b&gt;tracejada com triângulo vazio&lt;/b&gt;: a Infrastructure implementa as interfaces que a Application define (OpenDota, banco, parser).&lt;br&gt;O &lt;b&gt;Domain&lt;/b&gt; (regras do Dota) não depende de ninguém: não conhece HTTP, banco nem OpenDota." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1040" height="90" as="geometry" /></mxCell><mxCell id="coach-boundary" value="&lt;b&gt;Python é um processo separado, fora das camadas .NET.&lt;/b&gt;&lt;br&gt;Infrastructure implementa ICoachingReviewProvider via HTTP; Server oferece callbacks internos autenticados. Domain não depende de Python, HTTP ou ML. Prévia/inferência e treino são fluxos distintos." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1040" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram>
