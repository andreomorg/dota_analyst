<mxCell id="b7" value="baseline_distributions&lt;br&gt;(Neon · espelho)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="510" width="160" height="90" as="geometry" /></mxCell>
