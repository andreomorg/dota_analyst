<mxCell id="c6" value="espelha · KB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;html=1;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b5" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell>
