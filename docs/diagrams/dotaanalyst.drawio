                        <mxPoint x="325" y="430" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
            <mxCell id="legend-login" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;O tempo corre de cima para baixo. Seta &lt;b&gt;contínua&lt;/b&gt;: um pedido; &lt;b&gt;tracejada&lt;/b&gt;: a resposta.&lt;br&gt;A senha (ou o QR code do app) é digitada na &lt;b&gt;página da própria Steam&lt;/b&gt;: o site nunca vê senha nem token, só recebe o SteamID, confirmado com a Steam. Depois o navegador guarda um cookie de sessão que o JavaScript não consegue ler." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#f8f9fb;strokeColor=#9aa7b5;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="600" height="110" as="geometry"/></mxCell></root>
        </mxGraphModel>
    </diagram>
