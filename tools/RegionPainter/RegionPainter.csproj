<Project Sdk="Microsoft.NET.Sdk">

  <!-- Paints the terrain zones (Domain/Maps/TerrainZones) of a patch's map over its relief, and compares them with the
       old regions (MapRegions) on real positions, to check them by eye (work/map/). Not part of the solution nor of the
       Docker image: run it on the owner's machine (Windows: System.Drawing). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DotaAnalyst.Infrastructure\DotaAnalyst.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>
